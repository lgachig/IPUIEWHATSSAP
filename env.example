# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio.

# --- n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TIMEZONE=America/Guayaquil
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambia_esta_password

# --- Evolution API ---
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=cambia_esta_api_key

# --- Supabase (para la siguiente épica) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
